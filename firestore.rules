rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The account directory — readable by any signed-in user (needed for
    // search-by-name/ID and the classmates list), but not by signed-out
    // visitors. Each account may only be created/edited by the Firebase Auth
    // user who owns that uid.
    match /accounts/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared app metadata — currently just the 4-digit user ID counter,
    // incremented in a transaction at signup. Low-stakes, so any signed-in
    // user may read/update it.
    match /meta/{id} {
      allow read, write: if request.auth != null;
    }

    // Private per-user settings (nicknames). Never readable by anyone else.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // A user's own uploaded schedule. Readable by any signed-in user (so a
    // mutual friend's compare view can load it); only the owner can write it.
    match /schedules/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // One doc per "A shares with B" edge, id "{fromUid}__{toUid}".
    match /shares/{shareId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.from;
      allow delete: if request.auth != null && request.auth.uid == resource.data.from;
    }

    // Share alerts. Anyone signed in may create one addressed to someone
    // else; only the recipient can read or dismiss their own.
    match /notifications/{id} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.from;
      allow read, update: if request.auth != null && request.auth.uid == resource.data.to;
    }
  }
}
